// Store Ops platform database.
// Store data (orders, products...) is NOT copied here: it stays in each store
// and is fetched through adapters. Every tenant-owned table is scoped by
// store_id under Row-Level Security (see migrations/*_rls).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  SHOPIFY
  WOOCOMMERCE
  CUSTOM_REST
  SUPABASE
}

enum ConnectionStatus {
  ACTIVE
  ERROR
  REVOKED
}

enum PolicyMode {
  AUTO
  ASK
  NEVER
}

enum RunTrigger {
  CHAT
  SCHEDULE
  WEBHOOK
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  WAITING_APPROVAL
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Raised to sign the user out everywhere (password change or reset, "log out everywhere").
  sessionVersion      Int       @default(0) @map("session_version")
  /// Authenticator-app secret, encrypted like store credentials. Two-factor is on when totpEnabledAt is set.
  totpSecretEncrypted String?   @map("totp_secret_encrypted")
  totpEnabledAt       DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  /// SHA-256 hashes of unused recovery codes.
  recoveryCodes       String[]  @default([]) @map("recovery_codes")
  /// trial | starter | growth | custom. Changed only by billing (see migrations/*_accounts_and_plans).
  plan                String    @default("trial")
  /// trialing | pending | active | past_due | halted | cancelled
  planStatus          String    @default("trialing") @map("plan_status")
  trialEndsAt         DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP + '14 days'::interval)")) @map("trial_ends_at") @db.Timestamptz(3)
  planRenewsAt        DateTime? @map("plan_renews_at") @db.Timestamptz(3)
  /// Custom plans: stores and monthly AI usage allowed.
  planStoreLimit      Int?      @map("plan_store_limit")
  planAiAllowanceInr  Decimal?  @map("plan_ai_allowance_inr") @db.Decimal(10, 2)
  razorpaySubscriptionId String? @unique @map("razorpay_subscription_id")
  stores       Store[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// Password reset links. Only a hash of each token is stored; reached only through SECURITY DEFINER functions.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Store {
  id         String   @id @default(uuid()) @db.Uuid
  ownerId    String   @map("owner_id") @db.Uuid
  platform   Platform
  name       String
  currency   String   @db.Char(3)
  timezone   String
  isPaused   Boolean  @default(false) @map("is_paused")
  /// Most the agent may spend on this store in a calendar month (UTC), in rupees. Null uses the platform default.
  monthlyBudgetInr Decimal? @map("monthly_budget_inr") @db.Decimal(10, 2)
  /// The platform's own id for the store (Shopify: the myshopify.com domain).
  externalId String?  @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner      User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  connection StoreConnection?
  policies   Policy[]
  jobs       Job[]
  runs       AgentRun[]
  auditLog   AuditLog[]
  usage      Usage[]
  webhookEvents WebhookEvent[]
  drafts        Draft[]

  @@unique([platform, externalId])
  @@index([ownerId])
  @@map("stores")
}

model StoreConnection {
  id                   String           @id @default(uuid()) @db.Uuid
  storeId              String           @unique @map("store_id") @db.Uuid
  credentialsEncrypted String           @map("credentials_encrypted")
  scopes               String[]
  status               ConnectionStatus @default(ACTIVE)
  lastError            String?          @map("last_error")
  connectedAt          DateTime         @default(now()) @map("connected_at") @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_connections")
}

model Policy {
  id        String     @id @default(uuid()) @db.Uuid
  storeId   String     @map("store_id") @db.Uuid
  action    String
  mode      PolicyMode
  limits    Json       @default("{}")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, action])
  @@map("policies")
}

model Job {
  id        String    @id @default(uuid()) @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  type      String
  schedule  String
  isEnabled Boolean   @default(true) @map("is_enabled")
  /// Owner settings for the job, e.g. { "threshold": 3 } for the low-stock watch.
  config    Json      @default("{}")
  /// What the job has already handled, so it does not repeat itself.
  state     Json      @default("{}")
  lastRunAt DateTime? @map("last_run_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, type])
  @@map("jobs")
}

model AgentRun {
  id         String     @id @default(uuid()) @db.Uuid
  storeId    String     @map("store_id") @db.Uuid
  trigger    RunTrigger
  /// The autonomous job that started the run (trigger SCHEDULE or WEBHOOK).
  jobType    String?    @map("job_type")
  status     RunStatus  @default(RUNNING)
  input      String?
  output     String?
  error      String?
  startedAt  DateTime   @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?  @map("finished_at") @db.Timestamptz(3)
  tokensIn   Int        @default(0) @map("tokens_in")
  tokensOut  Int        @default(0) @map("tokens_out")
  costInr    Decimal    @default(0) @map("cost_inr") @db.Decimal(10, 4)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  toolCalls ToolCall[]
  drafts    Draft[]

  @@index([storeId, createdAt])
  @@map("agent_runs")
}

model ToolCall {
  id             String   @id @default(uuid()) @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  toolName       String   @map("tool_name")
  args           Json
  result         Json?
  policyDecision String   @map("policy_decision")
  latencyMs      Int?     @map("latency_ms")
  tokens         Int?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  run      AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  approval Approval?

  @@index([runId, createdAt])
  @@map("tool_calls")
}

model Approval {
  id         String         @id @default(uuid()) @db.Uuid
  toolCallId String         @unique @map("tool_call_id") @db.Uuid
  args       Json
  summary    String
  /// Why an Auto call needed approval (it broke a limit); null for Ask.
  reason     String?
  status     ApprovalStatus @default(PENDING)
  result     Json?
  error      String?
  decidedBy  String?        @map("decided_by") @db.Uuid
  decidedAt  DateTime?      @map("decided_at") @db.Timestamptz(3)
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  toolCall ToolCall @relation(fields: [toolCallId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@map("approvals")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  actor     String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("audit_log")
}

model Usage {
  id        String  @id @default(uuid()) @db.Uuid
  storeId   String  @map("store_id") @db.Uuid
  month     String  @db.Char(7) // YYYY-MM
  runs      Int     @default(0)
  tokens    Int     @default(0)
  costInr   Decimal @default(0) @map("cost_inr") @db.Decimal(12, 4)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, month])
  @@map("usage")
}

/// Webhooks received from a store's platform, kept for the job worker (Phase 6).
model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  topic       String
  /// The platform's delivery id, so retried deliveries are stored once.
  deliveryId  String    @map("delivery_id")
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, deliveryId])
  @@index([storeId, receivedAt])
  @@map("webhook_events")
}

enum DraftKind {
  CUSTOMER_MESSAGE
  REVIEW_REPLY
}

enum DraftStatus {
  PENDING
  SENT
  POSTED
  DISMISSED
}

/// Something the agent wrote for the owner to check: never sent or posted by the agent itself.
model Draft {
  id          String      @id @default(uuid()) @db.Uuid
  storeId     String      @map("store_id") @db.Uuid
  runId       String?     @map("run_id") @db.Uuid
  kind        DraftKind
  /// The order or review the draft is about.
  targetId    String      @map("target_id")
  /// What the owner sees, e.g. "Order RTS-1042 · Meera Sharma".
  targetLabel String      @map("target_label")
  recipient   Json?
  body        String
  status      DraftStatus @default(PENDING)
  decidedBy   String?     @map("decided_by") @db.Uuid
  decidedAt   DateTime?   @map("decided_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  store Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  run   AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([storeId, status, createdAt])
  @@index([storeId, kind, targetId])
  @@map("drafts")
}
