{
  "name": "@store-ops/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "postinstall": "prisma generate",
    "typecheck": "tsc -p tsconfig.json",
    "test": "dotenv -e ../../.env.test -e ../../.env -- vitest run",
    "migrate:test": "dotenv -e ../../.env.test -e ../../.env -- prisma migrate deploy",
    "setup:production": "tsx scripts/setup-app-role.ts && prisma migrate deploy",
    "set-plan": "dotenv -e ../../.env -- tsx scripts/set-plan.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "dotenv-cli": "8.0.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "vitest": "3.2.7"
  }
}
