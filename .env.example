# Platform database. Migrations run as the owner; the app connects as the
# non-owner `storeops_app` role so Row-Level Security always applies.
DATABASE_URL="postgresql://storeops:storeops@localhost:5433/storeops"
APP_DATABASE_URL="postgresql://storeops_app:storeops_app@localhost:5433/storeops"

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=""

# Session cookie signing secret (any long random string).
SESSION_SECRET=""

# Boutique (Supabase stand-in). The admin URL is only used by tests and seeding;
# the adapter connects as the restricted agent role.
BOUTIQUE_ADMIN_URL="postgresql://boutique:boutique@localhost:5434/boutique"
BOUTIQUE_AGENT_URL="postgresql://agent_role:agent_role@localhost:5434/boutique"

# Store addresses must be public (no localhost or private networks), so an
# owner cannot point the app at our own servers. Local development and tests
# run their test stores on localhost, so allow it here. Never set this in production.
ALLOW_PRIVATE_STORE_HOSTS="1"

# ---- Agent (Phase 2) --------------------------------------------------------
# Claude API key for the agent API and the worker: create it in the Claude
# Console (console.anthropic.com) under Settings → API keys, and copy it whole
# (it is shown only once). API use is billed to the Console account, separately
# from a Claude subscription. The agent API and the worker check the key when
# they start and log what is wrong.
# Leave it commented out (not empty) if you use `ant auth login` instead: an
# empty value would override that login.
# ANTHROPIC_API_KEY="sk-ant-..."
AGENT_MODEL="claude-opus-5-5"
AGENT_EFFORT="medium"
# Used to report run costs in rupees.
USD_TO_INR="84"

# Internal services. Tokens: any random string of 32+ characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENT_URL="http://127.0.0.1:3200"
AGENT_INTERNAL_TOKEN=""
MCP_URL="http://127.0.0.1:3201/mcp"
MCP_INTERNAL_TOKEN=""

# ---- Approvals (Phase 3) ------------------------------------------------------
# Signs one-time approval links in emails (32+ random characters).
APPROVAL_LINK_SECRET=""
# Where approval links point.
APP_URL="http://localhost:3100"
# Email via Resend. Without a key, emails are printed to the MCP server's console.
# RESEND_API_KEY="re_..."
EMAIL_FROM="Store Ops Agent <onboarding@resend.dev>"

# ---- Shopify (Phase 4) ---------------------------------------------------------
# From your app in the Shopify Dev Dashboard. See docs/shopify-setup.md.
# SHOPIFY_CLIENT_ID=""
# SHOPIFY_CLIENT_SECRET=""
# Extra scopes for a development store you want to seed (seeding creates products).
# SHOPIFY_EXTRA_SCOPES="write_products"
# Shopify needs a public HTTPS APP_URL for OAuth redirects and webhooks; locally,
# use a tunnel (for example cloudflared or ngrok) and set APP_URL to its address.

# Conformance runs against a seeded dev store: its platform store id after
# connecting it in the dashboard...
# SHOPIFY_TEST_STORE_ID=""
# ...or a non-expiring custom-app token instead:
# SHOPIFY_TEST_SHOP="your-dev-store.myshopify.com"
# SHOPIFY_TEST_ACCESS_TOKEN=""

# ---- Webhooks (Phase 5) ---------------------------------------------------------
# Base URL platforms deliver webhooks to, if not APP_URL. The local Docker
# WooCommerce store reaches the dashboard on the host at host.docker.internal.
# WEBHOOK_BASE_URL="http://host.docker.internal:3100"

# Local Docker WooCommerce store (docker compose --profile woo; see
# docs/woocommerce-setup.md). setup.sh prints these.
# WOO_TEST_URL="http://localhost:8080"
# WOO_TEST_KEY="ck_..."
# WOO_TEST_SECRET="cs_..."

# ---- Job worker (Phase 6) -------------------------------------------------------
# Redis for BullMQ (docker compose maps it to 6380).
REDIS_URL="redis://127.0.0.1:6380"

# ---- Budgets and rate limits (Phase 7) --------------------------------------------
# Monthly agent spend per store unless the owner sets their own.
DEFAULT_MONTHLY_BUDGET_INR="500"
# Client-side request rates per store.
# WOO_REQUESTS_PER_SECOND="5"
# CONNECTOR_REQUESTS_PER_SECOND="10"

# ---- Plans and billing (Razorpay) ------------------------------------------------
# Without these, the billing page explains that payments are not set up, and
# plans can still be set by hand: pnpm user:set-plan <email> <plan>.
# Keys from Razorpay Dashboard -> Account & Settings -> API keys (test keys locally).
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET=""
# Webhook to <APP_URL>/api/webhooks/razorpay with the subscription.* events; its secret:
# RAZORPAY_WEBHOOK_SECRET=""
# Plan ids from Subscriptions -> Plans (₹999 and ₹2,499 monthly).
# RAZORPAY_PLAN_STARTER="plan_..."
# RAZORPAY_PLAN_GROWTH="plan_..."
