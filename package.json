{
  "name": "store-ops-agent",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @store-ops/web --filter @store-ops/agent --filter @store-ops/mcp --filter @store-ops/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "pnpm --filter @store-ops/e2e e2e",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @store-ops/db migrate && pnpm --filter @store-ops/db migrate:test",
    "db:setup": "pnpm --filter @store-ops/db setup:production",
    "db:generate": "pnpm --filter @store-ops/db generate",
    "boutique:reset": "pnpm --filter @store-ops/adapters boutique:reset",
    "user:set-password": "pnpm --filter @store-ops/web set-password",
    "user:set-plan": "pnpm --filter @store-ops/db set-plan"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.28"
    }
  }
}
