{
  "name": "store-ops-agent",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @store-ops/web --filter @store-ops/agent --filter @store-ops/mcp dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @store-ops/db migrate",
    "db:generate": "pnpm --filter @store-ops/db generate",
    "boutique:reset": "pnpm --filter @store-ops/adapters boutique:reset"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
