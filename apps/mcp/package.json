{
  "name": "@store-ops/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server \u00e2\u20ac\u201d routes tools to the run's store adapter through the policy engine (Phase 2)",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
