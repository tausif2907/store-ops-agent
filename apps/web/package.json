    "@store-ops/tools": "workspace:*",
    "bcryptjs": "3.0.3",
    "gsap": "3.15.0",
    "jose": "6.2.12",
    "next": "15.5.28",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "dotenv-cli": "8.0.0",
